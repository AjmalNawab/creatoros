// CreatorOS: Phase 1 core schema.
// Rule: every brand-scoped row carries brandId; history is append-only (runs, audit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Brands ----------
model Brand {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  language    String   @default("ur")
  tone        String?
  settings    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks     Task[]
  approvals Approval[]
  projects  ContentProject[]
  ideas     Idea[]
}

// ---------- Agents ----------
model Agent {
  id           String   @id // stable key, e.g. "research", "script"
  name         String
  department   String
  description  String?
  enabled      Boolean  @default(true)
  // execution limits
  timeoutSec   Int      @default(600)
  maxAttempts  Int      @default(3)
  requiresApprovalAfter Boolean @default(false) // output must be human-approved before dependants run
  config       Json     @default("{}")          // instructions version, allowed tools, schemas refs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks Task[]
  runs  TaskRun[]
}

// ---------- Tasks ----------
enum TaskStatus {
  PENDING           // created, dependencies not yet met
  QUEUED            // ready to run
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED            // last attempt failed, retry scheduled (see nextAttemptAt)
  DEAD              // retries exhausted: dead-letter
  CANCELLED
  BLOCKED           // needs human action
  WAITING_AI        // waiting for an AI response (operator mode: Claude Code answers the AI queue)
  WAITING_HUMAN     // waiting for a human/operator action (e.g. browser upload via Chrome DevTools)
}

model Task {
  id            String     @id @default(uuid())
  brandId       String?
  brand         Brand?     @relation(fields: [brandId], references: [id])
  contentProjectId String?
  contentProject   ContentProject? @relation(fields: [contentProjectId], references: [id])
  parentTaskId  String?
  parent        Task?      @relation("TaskTree", fields: [parentTaskId], references: [id])
  children      Task[]     @relation("TaskTree")
  agentId       String
  agent         Agent      @relation(fields: [agentId], references: [id])
  type          String
  input         Json       @default("{}")
  output        Json?
  priority      Int        @default(100) // lower = sooner
  status        TaskStatus @default(PENDING)
  attempts      Int        @default(0)
  maxAttempts   Int        @default(3)
  nextAttemptAt DateTime?
  lastError     String?
  idempotencyKey String?   @unique
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime   @updatedAt

  dependsOn  TaskDependency[] @relation("dependent")
  dependents TaskDependency[] @relation("prerequisite")
  runs       TaskRun[]
  approvals  Approval[]
  aiRequests AiRequest[]
  humanActions HumanActionRequest[]

  @@index([status, priority, createdAt])
  @@index([brandId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("prerequisite", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  ABORTED   // emergency stop or lease lost
  DEFERRED  // agent paused to wait for an AI response or human action; lock released
}

// One row per execution attempt (append-only history)
model TaskRun {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id])
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])
  attempt     Int
  workerId    String
  lockToken   BigInt    // fencing token held while running
  status      RunStatus @default(RUNNING)
  output      Json?
  error       String?
  costUsd     Decimal   @default(0) @db.Decimal(12, 6)
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([taskId])
  @@index([agentId, startedAt])
}

// ---------- Global execution lock (single row id = 'global') ----------
model ExecutionLock {
  id         String    @id
  holder     String?   // TaskRun id
  workerId   String?
  token      BigInt    @default(0) // fencing token, increments on each acquire
  leaseUntil DateTime?
  acquiredAt DateTime?
}

// ---------- Approvals ----------
enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Approval {
  id          String           @id @default(uuid())
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id])
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id])
  type        String           // script | video | thumbnail | publish | spend ...
  subjectRef  String           // what is being approved (e.g. content version id / file path)
  contentHash String           // approval is valid only for this exact content
  decision    ApprovalDecision @default(PENDING)
  decidedBy   String?
  feedback    String?
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?

  @@index([decision])
}

// ---------- System ----------
model SystemSetting {
  key       String   @id // e.g. "emergency_stop"
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  actor     String   // "user:owner" | "agent:script" | "system:worker-1"
  action    String   // e.g. "task.created", "lock.acquired", "system.emergency_stop"
  entity    String?  // "task"
  entityId  String?
  brandId   String?
  data      Json     @default("{}")

  @@index([at])
  @@index([entity, entityId])
}

// ---------- Content ----------
model ContentProject {
  id        String   @id @default(uuid())
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  key       String   @unique // renderer key, e.g. "p002"
  slug      String   @unique // folder under content/, e.g. "002-volcanoes"
  title     String
  language  String   @default("ur")
  status    String   @default("in_production")
  params    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
  posts PlatformPost[]
}

// ---------- AI requests (provider-agnostic; operator mode = answered by Claude Code) ----------
enum AiRequestStatus {
  PENDING   // waiting for an answer
  ANSWERED  // answer submitted, not yet consumed by the agent
  CONSUMED  // validated and used by the agent
  REJECTED  // answer failed validation; a new request is created with the error
}

model AiRequest {
  id         String          @id @default(uuid())
  taskId     String
  task       Task            @relation(fields: [taskId], references: [id])
  agentId    String
  kind       String          // e.g. "research", "script", "visuals"
  inputHash  String          // same task input → same request; changed input (feedback) → new request
  format     String          // "json" | "text"
  prompt     String
  response   String?
  status     AiRequestStatus @default(PENDING)
  error      String?
  provider   String          @default("operator")
  answeredBy String?
  createdAt  DateTime        @default(now())
  answeredAt DateTime?

  @@index([status])
  @@index([taskId, kind, inputHash])
}

// ---------- Human / operator actions (Rev 1.1 Human Action Handler) ----------
enum HumanActionStatus {
  PENDING
  DONE
  CANCELLED
}

model HumanActionRequest {
  id          String            @id @default(uuid())
  taskId      String
  task        Task              @relation(fields: [taskId], references: [id])
  kind        String            // e.g. "youtube_upload"
  inputHash   String
  title       String
  instructions String           // markdown steps for the operator
  payload     Json              @default("{}") // exact approved package to use
  status      HumanActionStatus @default(PENDING)
  result      Json?             // e.g. { "url": "...", "videoId": "..." }
  completedBy String?
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([taskId, kind, inputHash])
}

// ---------- Published posts (one row per platform publication) ----------
model PlatformPost {
  id               String         @id @default(uuid())
  contentProjectId String
  contentProject   ContentProject @relation(fields: [contentProjectId], references: [id])
  platform         String         // youtube | facebook | instagram | tiktok | linkedin
  route            String         // browser | api | manual
  idempotencyKey   String         @unique // sha(video)+platform: prevents duplicate publishing
  approvalId       String?
  externalId       String?        // platform post/video id
  url              String?
  visibility       String?
  status           String         @default("published") // published | processing | failed | removed
  metadata         Json           @default("{}")        // title, description, tags actually used
  evidence         Json           @default("{}")        // verification details
  publishedAt      DateTime       @default(now())
  metrics          PostMetric[]

  @@index([contentProjectId])
}

// Engagement snapshot of one published post (append-only history: never updated or overwritten).
// null = unavailable / not shown by the platform; 0 = really zero.
model PostMetric {
  id             String       @id @default(uuid())
  platformPostId String
  platformPost   PlatformPost @relation(fields: [platformPostId], references: [id])
  brandId        String?
  source         String       // youtube_api | browser | manual
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  reach          Int?         // unique viewers / accounts reached
  watchTimeSec   Int?
  raw            Json         @default("{}")
  note           String?
  capturedAt     DateTime     @default(now())

  @@index([platformPostId, capturedAt])
}

// ---------- Strategy: proposed content ideas (Trend + Idea agents) ----------
enum IdeaStatus {
  PROPOSED
  SELECTED   // owner picked it → content project created
  REJECTED
}

model Idea {
  id               String     @id @default(uuid())
  brandId          String?
  brand            Brand?     @relation(fields: [brandId], references: [id])
  taskId           String     // the ideas task that proposed it
  rank             Int
  title            String     // working title (Urdu)
  topic            String     // topic in English (becomes the project topic)
  angle            String     // what makes our video different
  audience         String     // who it is for
  whyNow           String     // trend evidence summary
  evidence         Json       @default("[]") // [{source, detail, url?}]
  competition      String     // existing coverage and how we beat it
  keywords         Json       @default("[]")
  format           String     // "long" | "short"
  durationSec      Int
  platforms        Json       @default("[\"youtube\"]")
  score            Int        // 1-10 fit × opportunity
  status           IdeaStatus @default(PROPOSED)
  contentProjectId String?    @unique
  feedback         String?
  createdAt        DateTime   @default(now())
  decidedAt        DateTime?

  @@index([status])
  @@index([taskId])
}
